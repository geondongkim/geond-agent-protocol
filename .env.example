# Database
POSTGRES_USER=geond
POSTGRES_PASSWORD=geond_dev_password
POSTGRES_DB=geond
POSTGRES_PORT=55432
GEOND_DATABASE_URL=postgresql://geond:geond_dev_password@localhost:55432/geond

# Embeddings are enabled for the MVP. Leave GEOND_EMBEDDING_BASE_URL empty to use
# the OpenAI SDK default endpoint (https://api.openai.com/v1).
# Supported providers: openai, openai-compatible, gateway, github-models,
# azure-openai, local-openai-compatible, ollama, none.
GEOND_EMBEDDING_PROVIDER=openai
GEOND_EMBEDDING_MODEL=text-embedding-3-small
GEOND_EMBEDDING_BASE_URL=
GEOND_EMBEDDING_API_KEY=
GEOND_EMBEDDING_DIMENSIONS=1536
GEOND_EMBEDDING_MAX_CHARS=3000

# Azure OpenAI embeddings. GEOND_AZURE_OPENAI_EMBEDDING_DEPLOYMENT is the
# Azure deployment name, not necessarily the base model name.
GEOND_AZURE_OPENAI_ENDPOINT=
GEOND_AZURE_OPENAI_API_KEY=
GEOND_AZURE_OPENAI_AUTH_MODE=api-key
GEOND_AZURE_OPENAI_API_VERSION=2024-10-21
GEOND_AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Optional LLM model planning variables. Current MVP does not call chat models yet.
OPENAI_API_KEY=
GEOND_LLM_MODEL_REASONING=gpt-5.4
GEOND_LLM_MODEL_BALANCED=gpt-5.4-mini
GEOND_LLM_MODEL_FAST=gpt-5.4-nano

# Redaction and ingestion
GEOND_PRIVACY_MODE=redacted-cloud
GEOND_STORE_RAW_PAYLOADS=false
GEOND_MAX_IMPORT_BYTES=104857600
